{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": { "outputs": [] },
    "lint:fix": { "outputs": [] },
    "format": { "outputs": [] },
    "format:check": { "outputs": [] },
    "test": { "outputs": [] },
    "test:watch": {
      "cache": false,
      "persistent": true,
      "outputs": []
    },
    "test:coverage": { "outputs": [] },
    "typecheck": { "outputs": [] },
    "clean": {
      "cache": false,
      "outputs": []
    }
  }
}
