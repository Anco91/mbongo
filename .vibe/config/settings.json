{
  "$schema": "https://raw.githubusercontent.com/mistralai/vibe/main/schemas/config/v1/settings.json",
  "version": "1.0.0",
  
  "agent": {
    "name": "mbongo-expert-architect",
    "description": "Agent IA Expert Architecte - Spec-Driven Development, Clean Code, Craftsmanship",
    "persona": {
      "role": "Senior Software Architect & Craftsman",
      "expertise": [
        "TypeScript",
        "Node.js",
        "Clean Code",
        "Domain-Driven Design",
        "Spec-Driven Development",
        "Software Craftsmanship",
        "Architecture Logicielle",
        "Test-Driven Development"
      ],
      "principles": [
        "SOLID",
        "DRY",
        "KISS",
        "YAGNI",
        "Fail Fast",
        "Boy Scout Rule"
      ]
    },
    "behavior": {
      "strict_mode": true,
      "require_spec": true,
      "require_tests": true,
      "min_coverage": 80,
      "auto_create_todo": true,
      "auto_validate_spec": true,
      "clean_code_enforcement": "strict"
    }
  },
  
  "skills": {
    "enabled": [
      "spec-driven-development",
      "clean-code",
      "vibe:vibe"
    ],
    "spec-driven-development": {
      "path": "skills/spec-driven-development",
      "auto_activate": true,
      "strict_mode": true,
      "require_validation": true,
      "template_path": "skills/spec-driven-development/SPEC_TEMPLATE.md",
      "index_path": "docs/specs/INDEX.md"
    },
    "clean-code": {
      "path": "skills/clean-code",
      "auto_activate": true,
      "enforcement_level": "strict",
      "max_function_length": 30,
      "max_params": 4,
      "max_class_length": 200
    }
  },
  
  "project": {
    "type": "typescript-node",
    "entry_point": "src/index.ts",
    "test_pattern": [
      "**/__tests__/**/*.{ts,js}",
      "**/?(*.)+(spec|test).{ts,js}"
    ],
    "source_dir": "src",
    "test_dir": "tests",
    "docs_dir": "docs",
    "specs_dir": "docs/specs",
    "build_dir": "dist"
  },
  
  "workflow": {
    "default": {
      "pre_development": [
        "check_spec_exists",
        "check_spec_validated",
        "check_todo_synced"
      ],
      "post_development": [
        "run_linter",
        "run_tests",
        "check_coverage",
        "update_documentation"
      ]
    },
    "spec_workflow": {
      "steps": [
        "capture_requirements",
        "analyze_technical_constraints",
        "write_spec",
        "validate_spec",
        "generate_todo",
        "wait_for_approval"
      ]
    },
    "code_review": {
      "checklist": [
        "spec_compliance",
        "clean_code_check",
        "test_coverage",
        "documentation",
        "security_check"
      ]
    }
  },
  
  "quality_gates": {
    "linting": {
      "enabled": true,
      "strict": true,
      "auto_fix": true
    },
    "testing": {
      "enabled": true,
      "min_coverage": 80,
      "require_unit_tests": true,
      "require_integration_tests": true,
      "require_e2e_tests": false
    },
    "typing": {
      "enabled": true,
      "strict": true,
      "no_any": true,
      "no_unknown": true
    },
    "documentation": {
      "enabled": true,
      "require_jsdoc": true,
      "require_readme": true
    }
  },
  
  "todo": {
    "enabled": true,
    "file": "TODO.md",
    "auto_sync": true,
    "sync_with_specs": true,
    "sync_with_git": true
  },
  
  "git": {
    "auto_commit": false,
    "commit_message_template": "chore: {message}\n\nGenerated by Mistral Vibe.\nCo-Authored-By: Mistral Vibe <vibe@mistral.ai>",
    "branch_naming": {
      "feature": "feature/{spec-id}-{description}",
      "fix": "fix/{spec-id}-{description}",
      "refactor": "refactor/{description}",
      "chore": "chore/{description}"
    }
  },
  
  "validation": {
    "require_spec_for_code": true,
    "block_without_spec": true,
    "spec_validation_checklist": [
      "metadata_complete",
      "description_clear",
      "diagrams_up_to_date",
      "interfaces_defined",
      "business_rules_explicit",
      "error_cases_covered",
      "tests_specified",
      "nfr_defined",
      "dependencies_identified",
      "risks_analyzed",
      "estimation_realistic"
    ],
    "code_validation_checklist": [
      "spec_compliance",
      "clean_code_principles",
      "no_duplication",
      "proper_naming",
      "small_functions",
      "single_responsibility",
      "proper_error_handling",
      "type_safety",
      "tests_passing",
      "coverage_adequate"
    ]
  },
  
  "notifications": {
    "spec_validation_reminder": true,
    "todo_update_reminder": true,
    "quality_gate_failure": true,
    "blocked_development": true
  },
  
  "integration": {
    "vibe_cli": {
      "enabled": true,
      "version": "latest"
    },
    "editor": {
      "vs_code": {
        "recommended_extensions": [
          "dbaeumer.vscode-eslint",
          "esbenp.prettier-vscode",
          "ms-vscode.vscode-node-azure-pack",
          "msjsdiag.debugger-for-chrome",
          "mtxr.sqltools",
          "mtxr.sqltools-driver-pg"
        ]
      }
    }
  },
  
  "environment": {
    "node_version": ">=18.0.0",
    "npm_version": ">=9.0.0",
    "typescript_version": ">=5.0.0",
    "required_global_packages": [
      "typescript",
      "ts-node",
      "nodemon"
    ]
  }
}
