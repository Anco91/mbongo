{
  "name": "mbongo",
  "version": "2.0.0",
  "private": true,
  "description": "Monorepo for mbongo project - AI Agent Configuration with Spec-Driven Development and Clean Code",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "cd apps/web && npm run dev",
    "build": "turbo run build",
    "build:web": "cd apps/web && npm run build",
    "start": "cd apps/web && npm run start",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "prisma:generate": "cd apps/web && npx prisma generate",
    "prisma:migrate": "cd apps/web && npx prisma migrate dev",
    "prisma:studio": "cd apps/web && npx prisma studio",
    "prisma:push": "cd apps/web && npx prisma db push",
    "prisma:seed": "cd apps/web && npm run db:seed",
    "quality": "npm run lint && npm run format:check && npm run typecheck && npm run test",
    "quality:fix": "npm run lint:fix && npm run format && npm run typecheck && npm run test",
    "install:all": "npm install",
    "setup": "npm run install:all && npm run prisma:generate && npm run prisma:push"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "packageManager": "npm@9.0.0",
  "turbo": {
    "pipeline": {
      "build": {
        "dependsOn": ["^build"],
        "outputs": [".next/**", "!.next/cache/**", "dist/**"]
      },
      "dev": {
        "cache": false,
        "persistent": true
      },
      "lint": {
        "outputs": []
      },
      "lint:fix": {
        "outputs": []
      },
      "format": {
        "outputs": []
      },
      "format:check": {
        "outputs": []
      },
      "test": {
        "outputs": []
      },
      "test:watch": {
        "cache": false,
        "outputs": []
      },
      "test:coverage": {
        "outputs": []
      },
      "typecheck": {
        "outputs": []
      },
      "clean": {
        "cache": false,
        "outputs": []
      },
      "db:generate": {
        "cache": false
      },
      "db:migrate": {
        "cache": false
      },
      "db:studio": {
        "cache": false
      },
      "db:seed": {
        "cache": false
      }
    }
  }
}
