# Database
# SQLite (default for development)
DATABASE_URL="file:./dev.db"

# PostgreSQL
# DATABASE_URL="postgresql://user:password@localhost:5432/mbongo?schema=public"

# MySQL
# DATABASE_URL="mysql://user:password@localhost:3306/mbongo"

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"
