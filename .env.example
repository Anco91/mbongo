# =============================================================================
# mbongo - Configuration par Environnement
# =============================================================================
# 
# Ce fichier contient les variables d'environnement nécessaires pour le projet.
# Copiez ce fichier en `.env` et ajustez les valeurs selon votre configuration.
# 
# NE JAMAIS commiter le fichier .env dans git!
# 
# =============================================================================

# =============================================================================
# CONFIGURATION DE L'APPLICATION
# =============================================================================

# Environnement
# Valeurs possibles: development, test, staging, production
NODE_ENV=development

# Port de l'application
PORT=3000

# Host de l'application
HOST=localhost

# Niveau de logging
# Valeurs possibles: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info

# =============================================================================
# CONFIGURATION DE LA BASE DE DONNÉES (PostgreSQL)
# =============================================================================

# Hôte de la base de données
DB_HOST=localhost

# Port de la base de données
DB_PORT=5432

# Nom de la base de données
DB_NAME=mbongo

# Utilisateur de la base de données
DB_USER=postgres

# Mot de passe de la base de données
DB_PASSWORD=your_password_here

# SSL pour la connexion à la base de données
DB_SSL=false

# Pool de connexions
DB_POOL_MIN=2
DB_POOL_MAX=10

# Timeout de connexion (en ms)
DB_CONNECTION_TIMEOUT=5000

# =============================================================================
# CONFIGURATION DE LA BASE DE DONNÉES DE TEST
# =============================================================================

TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_NAME=mbongo_test
TEST_DB_USER=postgres
TEST_DB_PASSWORD=your_password_here

# =============================================================================
# CONFIGURATION REDIS (Cache)
# =============================================================================

# Hôte Redis
REDIS_HOST=localhost

# Port Redis
REDIS_PORT=6379

# Mot de passe Redis (optionnel)
REDIS_PASSWORD=

# Index de la base de données Redis
REDIS_DB=0

# Timeout Redis (en ms)
REDIS_TIMEOUT=5000

# =============================================================================
# CONFIGURATION JWT (Authentification)
# =============================================================================

# Clé secrète pour signer les tokens JWT
# GÉNÉREZ UNE NOUVELLE CLÉ EN PRODUCTION!
# Utilisez: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_duper_secret_key_here_change_it_in_production

# Durée de validité des tokens JWT
JWT_EXPIRES_IN=15m

# Durée de validité des refresh tokens
JWT_REFRESH_EXPIRES_IN=7d

# Algorithme de signature JWT
JWT_ALGORITHM=HS256

# =============================================================================
# CONFIGURATION DE LA SÉCURITÉ
# =============================================================================

# Clé secrète pour les sessions
SESSION_SECRET=your_session_secret_here

# Durée de validité des sessions (en ms)
SESSION_EXPIRES_IN=86400000

# Origin CORS autorisées (séparées par des virgules)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Méthodes CORS autorisées
CORS_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS

# Headers CORS autorisés
CORS_HEADERS=Origin,Content-Type,Accept,Authorization

# Taille maximale du payload (en octets)
MAX_PAYLOAD_SIZE=1048576

# Rate limiting (nombre de requêtes par minute)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# CONFIGURATION DES EMAILS (SMTP)
# =============================================================================

# Hôte SMTP
SMTP_HOST=smtp.example.com

# Port SMTP
SMTP_PORT=587

# Sécurité SMTP (true pour TLS, 'STARTTLS' pour STARTTLS)
SMTP_SECURE=false

# Utilisateur SMTP
SMTP_USER=your_email@example.com

# Mot de passe SMTP
SMTP_PASSWORD=your_smtp_password

# Email de l'expéditeur
SMTP_FROM=noreply@mbongo.com

# =============================================================================
# CONFIGURATION DES FICHIERS
# =============================================================================

# Dossier de stockage des fichiers
UPLOAD_DIR=./uploads

# Taille maximale des fichiers (en octets)
MAX_FILE_SIZE=10485760

# Types de fichiers autorisés (séparés par des virgules)
ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf

# =============================================================================
# CONFIGURATION DES SERVICES EXTERNES
# =============================================================================

# Clé API Stripe (Paiements)
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Clé API SendGrid (Emails)
SENDGRID_API_KEY=your_sendgrid_api_key

# Clé API AWS S3 (Stockage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your_bucket_name

# =============================================================================
# CONFIGURATION DU MONITORING
# =============================================================================

# Clé API Sentry (Erreur tracking)
SENTRY_DSN=your_sentry_dsn

# Environnement Sentry
SENTRY_ENVIRONMENT=development

# Clé API Datadog (Monitoring)
DATADOG_API_KEY=your_datadog_api_key

# =============================================================================
# CONFIGURATION POUR LE DÉVELOPPEMENT
# =============================================================================

# Hot reload
HOT_RELOAD=true

# Debug mode
DEBUG=true

# =============================================================================
# CONFIGURATION POUR LA PRODUCTION
# =============================================================================

# En production, mettez à jour ces valeurs:
# NODE_ENV=production
# LOG_LEVEL=warn
# HOST=0.0.0.0
# DB_SSL=true
# JWT_EXPIRES_IN=15m (ou moins)
# RATE_LIMIT_MAX_REQUESTS=1000
# DEBUG=false
# HOT_RELOAD=false

# =============================================================================
# NOTES IMPORTANTES
# =============================================================================
#
# 1. GÉNÉRATION DES CLÉS SECRÈTES:
#    - JWT_SECRET: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#    - SESSION_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# 2. NE JAMAIS utiliser ces valeurs en production:
#    - your_password_here
#    - your_super_duper_secret_key_here
#    - your_* (toute valeur par défaut)
#
# 3. Pour la production, utilisez des variables d'environnement sécurisées:
#    - Services comme AWS Parameter Store
#    - Kubernetes Secrets
#    - Docker Secrets
#    - Fichiers .env protégés
#
# 4. Pour le développement, vous pouvez utiliser:
#    - dotenv pour charger .env
#    - cross-env pour passer des variables en ligne de commande
#
# =============================================================================
